# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:replace-me
# Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-me
# Comma-separated Telegram user IDs allowed to talk to the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=111111111,222222222
# Required: IANA timezone used when showing times to you
TIMEZONE=Europe/London
# Optional model overrides
# DEFAULT_MODEL=claude-sonnet-5-5
# FAST_MODEL=claude-haiku-5-5
# Optional: where the SQLite database lives (default data/pocket.db)
# DB_PATH=data/pocket.db
# Optional: currency symbol for expenses (default $)
# CURRENCY=$
# Optional: city for weather when none is known (e.g. Toronto)
# HOME_CITY=Toronto
# Optional: default morning briefing time, HH:MM in TIMEZONE
# BRIEFING_TIME=07:30
# Optional: Brave Search API key for web search (https://brave.com/search/api/)
# BRAVE_API_KEY=
# Optional: daily spend limit in USD (0 = no limit). Over it the bot uses
# FAST_MODEL; at 2x it refuses chat messages until tomorrow.
# DAILY_BUDGET_USD=1.00
# Optional: where run logs and nightly backups go
# LOG_DIR=data/logs
# BACKUP_DIR=data/backups
# BACKUP_TIME=03:00
